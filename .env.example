# Public Convex deployment URL, created by `pnpm convex dev`. This is the only
# frontend setting. Leave it empty to run the site on local demo state.
NEXT_PUBLIC_CONVEX_URL=

# Staff PINs are server-side only: set them with `pnpm exec convex env set`,
# never in Vercel or .env.local. Volunteers receive revocable one-room links.
# HOST_PIN=        Game Master (/host), needed only for a game night
# QA_ADMIN_PIN=    Ask the Clergy moderators (/qa/admin)
