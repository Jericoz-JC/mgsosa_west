# Public Convex deployment URL, created by `pnpm convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# Public Game Mode event code from lib/game/event-config.ts. It grants no staff access.
NEXT_PUBLIC_EVENT_CODE=WINTER27

# Server-only credential configured with `convex env set`.
# Only the Game Master uses a PIN. Volunteers receive revocable one-room links.
HOST_PIN=
# Ask the Clergy moderators (/qa/admin). Falls back to HOST_PIN when unset.
QA_ADMIN_PIN=
